{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Application Performance Metrics",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "title": "Throughput (TPS)",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2
          },
          "unit": "ops"
        }
      },
      "targets": [
        {
          "expr": "medvault_tps",
          "legendFormat": "{{operation}} ({{users}} users)"
        }
      ]
    },
    {
      "title": "Latency (p95)",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2
          },
          "unit": "ms"
        }
      },
      "targets": [
        {
          "expr": "medvault_latency_p95_ms",
          "legendFormat": "{{operation}} ({{users}} users)"
        }
      ]
    },
    {
      "title": "Success Rate",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "targets": [
        {
          "expr": "medvault_success_rate_percent",
          "legendFormat": "{{operation}} ({{users}} users)"
        }
      ]
    },
    {
      "title": "System Overview",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "collapsed": false
    },
    {
      "title": "Host CPU Usage %",
      "description": "Overall host CPU utilization. >80% sustained indicates hardware bottleneck.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2,
            "spanNulls": false
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "targets": [
        {
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
          "legendFormat": "CPU Usage %"
        }
      ]
    },
    {
      "title": "Host Memory Usage",
      "description": "Available vs total memory. Low available memory causes OOM kills and swap thrashing.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2
          },
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
          "legendFormat": "Used Memory"
        },
        {
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "Available Memory"
        }
      ]
    },
    {
      "title": "Host Network I/O",
      "description": "Network throughput. High TX during IPFS uploads, high RX during retrievals.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "unit": "Bps"
        }
      },
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total{device!=\"lo\"}[1m])",
          "legendFormat": "RX {{device}}"
        },
        {
          "expr": "rate(node_network_transmit_bytes_total{device!=\"lo\"}[1m])",
          "legendFormat": "TX {{device}}"
        }
      ]
    },
    {
      "title": "Container Metrics",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "collapsed": false
    },
    {
      "title": "Container CPU Usage",
      "description": "Per-container CPU consumption. Identifies which service (IPFS vs Hardhat) is the bottleneck.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2
          },
          "unit": "percent"
        }
      },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{name=~\".*hardhat.*|.*ipfs.*|.*grafana.*|.*prometheus.*\"}[1m]) * 100",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "title": "Container Memory Usage",
      "description": "Per-container memory consumption. IPFS memory grows with stored objects; Hardhat memory grows with state.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2
          },
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "expr": "container_memory_usage_bytes{name=~\".*hardhat.*|.*ipfs.*|.*grafana.*|.*prometheus.*\"}",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "title": "Container Network I/O",
      "description": "Per-container network throughput. Correlate with benchmark phases to identify I/O-bound operations.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "unit": "Bps"
        }
      },
      "targets": [
        {
          "expr": "rate(container_network_receive_bytes_total{name=~\".*hardhat.*|.*ipfs.*\"}[1m])",
          "legendFormat": "RX {{name}}"
        },
        {
          "expr": "rate(container_network_transmit_bytes_total{name=~\".*hardhat.*|.*ipfs.*\"}[1m])",
          "legendFormat": "TX {{name}}"
        }
      ]
    },
    {
      "title": "Container Disk I/O",
      "description": "Disk read/write per container. IPFS is disk-heavy during adds; Hardhat uses memory-backed state.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "unit": "Bps"
        }
      },
      "targets": [
        {
          "expr": "rate(container_fs_reads_bytes_total{name=~\".*hardhat.*|.*ipfs.*\"}[1m])",
          "legendFormat": "Read {{name}}"
        },
        {
          "expr": "rate(container_fs_writes_bytes_total{name=~\".*hardhat.*|.*ipfs.*\"}[1m])",
          "legendFormat": "Write {{name}}"
        }
      ]
    }
  ],
