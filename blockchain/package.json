{
  "name": "blockchain",
  "version": "1.0.0",
  "description": "Medical Document Management System — Ethereum + IPFS",
  "main": "index.js",
  "scripts": {
    "compile": "node ./node_modules/hardhat/internal/cli/bootstrap.js compile",
    "compile:local": "node scripts/manual-compile.js",
    "deploy": "node ./node_modules/hardhat/internal/cli/bootstrap.js run scripts/deploy.js --network localhost",
    "deploy:v2": "node ./node_modules/hardhat/internal/cli/bootstrap.js run scripts/deploy-v2.js --network localhost",
    "deploy:v2:hardhat": "node ./node_modules/hardhat/internal/cli/bootstrap.js run scripts/deploy-v2.js --network hardhat",
    "benchmark:baseline": "node ./node_modules/hardhat/internal/cli/bootstrap.js run scripts/baseline-gas.js --network hardhat",
    "benchmark:optimized": "node ./node_modules/hardhat/internal/cli/bootstrap.js run scripts/optimized-gas.js --network hardhat",
    "benchmark:optimized:local": "node ./node_modules/hardhat/internal/cli/bootstrap.js run --no-compile scripts/optimized-gas.js --network hardhat",
    "benchmark": "node ./node_modules/hardhat/internal/cli/bootstrap.js run scripts/benchmark.js --network hardhat",
    "compare:gas": "node scripts/compare-gas.js",
    "run:optimized-flow": "bash scripts/run-optimized-flow.sh",
    "analyze": "node scripts/analyze-results.js",
    "generate-graphs": "node scripts/generate-graphs.js",
    "benchmark:report": "node scripts/generate-benchmark-report.js",
    "benchmark:full": "npm run benchmark && npm run analyze && npm run generate-graphs && npm run benchmark:report",
    "test": "node ./node_modules/hardhat/internal/cli/bootstrap.js test",
    "test:local": "node ./node_modules/hardhat/internal/cli/bootstrap.js test --no-compile",
    "test:report": "node ./node_modules/hardhat/internal/cli/bootstrap.js test && node scripts/generate-test-report.js",
    "test:coverage": "node ./node_modules/hardhat/internal/cli/bootstrap.js coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.3.2",
    "chai": "^4.5.0",
    "ethers": "^6.16.0",
    "hardhat": "^2.26.2",
    "hardhat-gas-reporter": "^2.3.0",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "@openzeppelin/hardhat-upgrades": "^3.9.1"
  }
}
