# Medical Document Verification System — Environment Variables
# Copy this file to .env and fill in the values.

# IPFS gateway for document storage (local or remote)
REACT_APP_IPFS_API=http://127.0.0.1:5001/api/v0

# (Optional) Contract addresses are auto-loaded from src/config/contracts.json
# after running: npm run deploy:v2 (from the blockchain/ directory)
